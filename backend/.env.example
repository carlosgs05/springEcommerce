# Copia este archivo a .env y completa los valores. .env NO se sube a git.
# EN PRODUCCION es obligatorio SPRING_PROFILES_ACTIVE=prod: sin eso arranca en modo
# desarrollo (SQL en los logs y Flyway aceptando una base sin historial sin ejecutar V1).
DB_URL=jdbc:postgresql://localhost:5432/Ecommerce
DB_USERNAME=postgres
DB_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=
# Origenes permitidos por CORS, separados por coma
ALLOWED_ORIGIN=http://localhost:5173
# URL publica del frontend: la usan los enlaces de los correos (verificar cuenta). Obligatoria en produccion.
FRONTEND_URL=http://localhost:5173
# Clave JWT: 64 bytes aleatorios en Base64, en una sola linea.
# Generar: openssl rand -base64 64 | tr -d '\n'
#   o PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET=
